{
  "description": "Decimal price <-> integer tick conversion cases, shared by the C++ and TypeScript test suites. Each group is self-contained: its config overrides the instrument's priceDecimals, minPriceTicks and maxPriceTicks. roundTrip pairs are canonical in both directions; parse inputs are accepted but not canonical; invalid inputs must fail with the given error code.",
  "groups": [
    {
      "name": "NOVA (2 decimals)",
      "config": { "priceDecimals": 2, "minPriceTicks": 1, "maxPriceTicks": 100000000 },
      "roundTrip": [
        { "decimal": "0.01", "ticks": 1 },
        { "decimal": "0.10", "ticks": 10 },
        { "decimal": "1.00", "ticks": 100 },
        { "decimal": "12.34", "ticks": 1234 },
        { "decimal": "142.50", "ticks": 14250 },
        { "decimal": "999999.99", "ticks": 99999999 },
        { "decimal": "1000000.00", "ticks": 100000000 }
      ],
      "parse": [
        { "input": "142.5", "ticks": 14250 },
        { "input": "142", "ticks": 14200 },
        { "input": "0142.50", "ticks": 14250 },
        { "input": "0.1", "ticks": 10 },
        { "input": "1000000", "ticks": 100000000 },
        { "input": "000000000000000000000001.00", "ticks": 100 }
      ],
      "invalid": [
        { "input": "", "error": "empty" },
        { "input": "-1", "error": "invalid-format" },
        { "input": "+1", "error": "invalid-format" },
        { "input": "1e3", "error": "invalid-format" },
        { "input": "1E3", "error": "invalid-format" },
        { "input": "abc", "error": "invalid-format" },
        { "input": " 1", "error": "invalid-format" },
        { "input": "1 ", "error": "invalid-format" },
        { "input": "1.", "error": "invalid-format" },
        { "input": ".5", "error": "invalid-format" },
        { "input": "1,000", "error": "invalid-format" },
        { "input": "1.2.3", "error": "invalid-format" },
        { "input": "0x10", "error": "invalid-format" },
        { "input": "Infinity", "error": "invalid-format" },
        { "input": "NaN", "error": "invalid-format" },
        { "input": "１", "error": "invalid-format" },
        { "input": "1.234", "error": "too-many-decimals" },
        { "input": "0.001", "error": "too-many-decimals" },
        { "input": "1.000", "error": "too-many-decimals" },
        { "input": "99999999999.999", "error": "too-many-decimals" },
        { "input": "0", "error": "out-of-range" },
        { "input": "0.00", "error": "out-of-range" },
        { "input": "1000000.01", "error": "out-of-range" },
        { "input": "1000001", "error": "out-of-range" },
        { "input": "99999999999999999999999", "error": "out-of-range" }
      ]
    },
    {
      "name": "whole units (0 decimals)",
      "config": { "priceDecimals": 0, "minPriceTicks": 1, "maxPriceTicks": 1000 },
      "roundTrip": [
        { "decimal": "1", "ticks": 1 },
        { "decimal": "57", "ticks": 57 },
        { "decimal": "1000", "ticks": 1000 }
      ],
      "parse": [{ "input": "007", "ticks": 7 }],
      "invalid": [
        { "input": "", "error": "empty" },
        { "input": "-5", "error": "invalid-format" },
        { "input": "1.0", "error": "too-many-decimals" },
        { "input": "0", "error": "out-of-range" },
        { "input": "1001", "error": "out-of-range" }
      ]
    }
  ]
}
