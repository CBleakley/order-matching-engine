# Copy to .env (git-ignored) and fill in. docker compose reads it automatically.

# Required. Signs session tokens; at least 32 random characters. Generate one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Optional. Defaults shown.
# HTTP_PORT=8080
# PUBLIC_ORIGIN=http://localhost:8080,http://127.0.0.1:8080
# ENGINE_WARMUP=6h
# ENGINE_LOG_LEVEL=info
# GATEWAY_LOG_LEVEL=info
