# Golden CLI transcripts are compared byte for byte (after dropping CRs);
# keep them LF everywhere so diffs stay clean.
tests/golden/** text eol=lf

# Prettier expects LF; keep Node sources LF even with core.autocrlf=true.
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf
.nvmrc text eol=lf
.npmrc text eol=lf
